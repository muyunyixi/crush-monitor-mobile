.page { min-height:100vh; background:#f5f5f2; color:#26332f; font-size:30rpx; box-sizing:border-box; }
.screen { padding:32rpx 32rpx 64rpx; }
.screen-head,.chat-head { display:flex; align-items:center; justify-content:space-between; min-height:96rpx; }
.eyebrow { color:#689083; font-size:22rpx; letter-spacing:2rpx; }
.heading { font-size:40rpx; font-weight:600; line-height:1.4; }
.intro,.hint { color:#73827c; font-size:25rpx; line-height:1.6; margin:18rpx 0 28rpx; }
button::after { border:0; }
button { box-sizing:border-box; }
.nav { flex:0 0 88rpx; height:88rpx; line-height:88rpx; margin:0; padding:0; background:transparent; color:#34574d; font-size:46rpx; }
.text-button { margin:0; padding:0 20rpx; background:#e1eee7; color:#316557; font-size:27rpx; border-radius:18rpx; min-height:88rpx; line-height:88rpx; }
.conversation,.setting-card,.detail-card { background:#fff; border:1rpx solid #e7ece7; border-radius:24rpx; padding:24rpx; margin-bottom:18rpx; box-shadow:0 6rpx 20rpx rgba(39,61,50,.035); }
.conversation-title { font-size:32rpx; font-weight:600; }
.conversation-summary { color:#64746d; font-size:26rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin:12rpx 0; }
.conversation-count { color:#6c9587; font-size:23rpx; }
.chat-screen { height:100vh; display:flex; flex-direction:column; }
.chat-head { flex:none; background:#fff; padding:0 16rpx; border-bottom:1rpx solid #e6ece7; }
.chat-heading { font-size:34rpx; font-weight:600; max-width:490rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.chat-history { flex:1; height:0; box-sizing:border-box; padding:20rpx 24rpx; }
.empty { color:#74857f; font-size:27rpx; line-height:1.7; padding:56rpx 26rpx; text-align:center; }
.message-row { display:flex; margin:14rpx 0; }
.message-row.self { justify-content:flex-end; }
.message-row.other { justify-content:flex-start; }
.bubble { background:#fff; border:1rpx solid #e8eee9; border-radius:20rpx; padding:16rpx 20rpx; max-width:78%; min-width:80rpx; word-break:break-word; line-height:1.48; }
.self .bubble { background:#e3f0e9; border-color:#daebe1; }
.highlight .bubble { border-color:#477f73; background:#f5f2da; }
.message-text { font-size:30rpx; white-space:pre-wrap; }
.timestamp,.speaker { color:#788982; font-size:22rpx; margin-bottom:6rpx; }
.message-label { display:inline-block; color:#416e63; font-size:22rpx; margin-top:8rpx; }
.composer { flex:none; background:#fff; border-top:1rpx solid #e3eae5; padding:12rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); }
.summary { display:flex; align-items:center; flex-wrap:wrap; gap:6rpx 18rpx; border:1rpx solid #e9efeb; border-radius:18rpx; padding:10rpx 14rpx; }
.summary-item { display:flex; align-items:baseline; gap:6rpx; color:#60766c; font-size:23rpx; white-space:nowrap; }
.number { font-size:42rpx; line-height:1.2; font-variant-numeric:tabular-nums; color:#2c6655; font-weight:600; min-width:1.8em; text-align:right; }
.unit { font-size:22rpx; color:#84948b; }
.summary-action { width:100%; color:#3d7565; font-size:24rpx; }
.charm-strip { white-space:nowrap; overflow-x:auto; padding:12rpx 0 2rpx; }
.charm { display:inline-block; margin-right:10rpx; padding:6rpx 16rpx; border-radius:20rpx; background:#edf3ee; color:#557364; font-size:22rpx; }
.editor { width:100%; min-height:86rpx; max-height:260rpx; padding:16rpx; margin-top:12rpx; box-sizing:border-box; border:1rpx solid #dce8df; border-radius:16rpx; background:#fafcfa; font-size:28rpx; line-height:1.45; }
.review-hint { color:#677b70; font-size:22rpx; line-height:1.5; margin-top:8rpx; }
.scope-button,.return-anchor { min-height:88rpx; width:100%; margin:8rpx 0 0; padding:0 12rpx; text-align:left; background:transparent; color:#3d7565; font-size:25rpx; line-height:88rpx; }
.return-anchor { background:#edf3ee; border-radius:14rpx; margin:0 0 8rpx; }
.actions { display:flex; gap:14rpx; margin-top:12rpx; }
.primary,.secondary { margin:0; border-radius:16rpx; font-size:27rpx; min-height:88rpx; line-height:88rpx; padding:0 22rpx; }
.primary { color:#fff; background:#477f73; flex:1; }
.secondary { color:#336d5d; background:#e8f2ec; }
.save-state { color:#849189; font-size:22rpx; margin-top:8rpx; }
.task-retry { color:#3d7565; background:transparent; font-size:23rpx; min-height:88rpx; line-height:1.4; margin:8rpx 0 0; padding:16rpx 0; text-align:left; }
.status { color:#436d5e; font-size:24rpx; line-height:1.55; margin-top:12rpx; }
.detail-card { margin-top:20rpx; }
.detail-value { font-size:56rpx; color:#356f5d; font-variant-numeric:tabular-nums; }
.detail-grade { font-size:36rpx; font-weight:600; color:#356f5d; }
.detail-copy,.detail-line { line-height:1.6; margin:14rpx 0; }
.field-label { font-size:24rpx; color:#657a6d; margin:16rpx 0 8rpx; }
.field { min-height:80rpx; line-height:80rpx; border-bottom:1rpx solid #e9eeea; }
.setting-row { min-height:96rpx; width:100%; display:flex; align-items:center; justify-content:space-between; font-size:28rpx; border-bottom:1rpx solid #edf0ed; background:transparent; text-align:left; padding:0; margin:0; }
.danger { color:#a35e55; }
.export-preview { display:block; width:100%; margin:20rpx 0; }
.export-canvas { position:fixed; left:-10000px; top:0; opacity:0; pointer-events:none; }
