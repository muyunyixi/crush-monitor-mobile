{
  "name": "crush-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && node scripts/inline-build.mjs && node scripts/copy-ocr.mjs",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts && npm run test:mini",
    "test:mini": "node --test apps/miniprogram/tests/*.test.js",
    "check:live": "tsx scripts/check-live.ts",
    "setup": "node scripts/setup.mjs",
    "export:source": "node scripts/export-source.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/express": "^5.0.0",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "license": "MIT",
  "description": "Mobile WeChat-style conversation analysis with optional personal TypeSafe API keys",
  "engines": {
    "node": ">=22.12.0"
  }
}
